# Standalone SEMS staging on sems-vm (own Traefik + Cloud SQL Auth Proxy).
# Reuses the existing Cloud SQL instance (sems_db / sems_user).

# Cloud SQL connection name: project:region:instance
CLOUD_SQL_CONNECTION_NAME=your-gcp-project:region:existing-instance

# Host must be the SEMS proxy container on sems-network-staging.
DATABASE_URL=postgresql+asyncpg://sems_user:YOUR_PASSWORD@sems-cloud-sql-proxy-staging:5432/sems_db

SECRET_KEY=
ENVIRONMENT=staging

# Browser origins for CORS (HTTPS origin that serves the SPA on this VM).
# CSV (recommended) or JSON array.
CORS_ORIGINS=https://sems.ctvetlabs.com

# Super admin created on first start if missing (required for initial login)
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change-me
SUPER_ADMIN_FULL_NAME=Super Admin

# Logging (APP_ prefix for LoggingSettings in app/config.py)
APP_ENV=staging
APP_LOG_LEVEL=INFO
APP_LOG_FORMAT=json

# Reducto document extraction (required when REDUCTO_ENABLED is true)
REDUCTO_API_KEY=

STORAGE_BACKEND=gcs
GCS_BUCKET_NAME=your-project-exam-tools-staging-files
GCS_PROJECT_ID=your-gcp-project
# VM service account uses ADC; set only if using a key file inside the container:
# GCS_CREDENTIALS_PATH=/path/to/service-account.json
GCS_DOCUMENTS_PREFIX=sems/documents
GCS_PHOTOS_PREFIX=sems/photos
GCS_SCORE_SHEETS_PREFIX=sems/score-sheets
# Direct-to-GCS upload tuning (optional)
# UPLOAD_SIGNED_URL_TTL_MINUTES=30
# UPLOAD_INITIATE_BATCH_MAX=200
# UPLOAD_PENDING_TTL_HOURS=2
# Apply bucket CORS for browser PUTs: gsutil cors set gcp/gcs-cors-documents.json gs://$GCS_BUCKET_NAME

# --- Frontend: compose omits NEXT_PUBLIC_API_BASE_URL so the browser derives
# sems-api.<same-parent-domain> (see frontend/lib/api.ts). The frontend
# container sets INTERNAL_API_BASE_URL to the compose service for any SSR.

# --- deploy.sh health-check domains ---
STAGING_FRONTEND_DOMAIN=sems.ctvetlabs.com
STAGING_API_DOMAIN=sems-api.ctvetlabs.com
