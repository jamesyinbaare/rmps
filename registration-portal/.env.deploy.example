# Deployment Environment Variables for Traefik Setup
# Copy this file to .env.deploy and update with your actual values

# Database Configuration
POSTGRES_USER=registration_user
POSTGRES_PASSWORD=your_secure_password_here
REGISTRATION_POSTGRES_DB=registration_portal_db
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@registration_postgres:5432/${REGISTRATION_POSTGRES_DB}

# Application Environment
ENVIRONMENT=production
APP_ENV=prod
APP_LOG_LEVEL=INFO
APP_LOG_FORMAT=json

# Security - IMPORTANT: Change these in production!
SECRET_KEY=your-very-secure-secret-key-change-this-in-production
ALGORITHM=HS256

# Authentication Settings
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=8

# System Admin Initialization (Required)
SYSTEM_ADMIN_EMAIL=jamesyinbaare@gmail.com
SYSTEM_ADMIN_PASSWORD=tesla1234
SYSTEM_ADMIN_FULL_NAME="System Administrator"

# Frontend Configuration
NEXT_PUBLIC_API_BASE_URL=https://api.backend.localhost
FRONTEND_BASE_URL=https://frontend.localhost

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=https://frontend.localhost,http://localhost:3001,http://127.0.0.1:3001

# Storage Configuration
STORAGE_BACKEND=local
STORAGE_PATH=storage/documents
PHOTO_STORAGE_PATH=storage/photos
EXPORT_STORAGE_PATH=storage/exports
CERTIFICATE_REQUEST_STORAGE_PATH=storage/certificate_requests

# File Upload Limits
STORAGE_MAX_SIZE=52428800
PHOTO_MAX_FILE_SIZE=2097152
UPLOAD_MAX_SIZE=10485760

# Photo Validation
PHOTO_MAX_WIDTH=600
PHOTO_MAX_HEIGHT=600
PHOTO_MIN_WIDTH=200
PHOTO_MIN_HEIGHT=200

# Payment Configuration (Paystack)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_CALLBACK_BASE_URL=https://frontend.localhost

# Certificate Request Pricing
CERTIFICATE_REQUEST_PRICE=100
ATTESTATION_REQUEST_PRICE=80
COURIER_FEE=50
EXPRESS_SERVICE_MULTIPLIER=1.5

# PDF Signing Configuration
PDF_SIGNING_ENABLED=false
PDF_SIGNING_CERTIFICATE_PATH=
PDF_SIGNING_KEY_PATH=
PDF_SIGNING_CERTIFICATE_PASSWORD=
PDF_SIGNING_CERTIFICATE_CHAIN_PATH=
PDF_SIGNING_REASON=Certificate Confirmation Response
PDF_SIGNING_LOCATION=Ghana
PDF_SIGNING_CONTACT_INFO=
PDF_SIGNING_ORGANIZATION=

# API Key Configuration
API_KEY_DEFAULT_RATE_LIMIT_PER_MINUTE=60
API_KEY_MAX_RATE_LIMIT_PER_MINUTE=1000
API_KEY_BULK_REQUEST_MAX_ITEMS=100
API_KEY_USAGE_RETENTION_DAYS=90

# Credit System
CREDIT_COST_PER_VERIFICATION=8
CREDIT_MINIMUM_PURCHASE=10
CREDIT_PURCHASE_PRICE_PER_UNIT=8.00

# Permission Management
PERMISSION_MANAGEMENT_MIN_ROLE=Director
