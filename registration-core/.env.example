# Local development environment for registration-core
# Copy to .env and update values before `docker compose up`

# Database Configuration
POSTGRES_USER=registration_user
POSTGRES_PASSWORD=changeme
REGISTRATION_POSTGRES_DB=registration_core_db
DATABASE_URL=postgresql+asyncpg://registration_user:changeme@registration_core_postgres:5432/registration_core_db

# Application Environment
ENVIRONMENT=development
APP_ENV=dev
APP_LOG_LEVEL=INFO
APP_LOG_FORMAT=text

# Security — outside development, SECRET_KEY must be a strong random value (boot refuses the default)
SECRET_KEY=registration-core-secret-key-change-in-production
ALGORITHM=HS256
# Optional shared rate limiting (empty = in-process)
REDIS_URL=
# Break-glass: allow creating SystemAdmin via API (defaults to true only in development)
# ALLOW_SYSTEM_ADMIN_PROVISIONING=false
# PASSWORD_BREACH_CHECK_ENABLED=false
# MAX_REFRESH_SESSIONS_PER_USER=5

# Authentication Settings
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=12

# System Admin Initialization (Required)
SYSTEM_ADMIN_EMAIL=admin@example.com
SYSTEM_ADMIN_PASSWORD=changeme
SYSTEM_ADMIN_FULL_NAME="System Administrator"

# Frontend Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8002
FRONTEND_BASE_URL=http://localhost:3002

# SMTP / email (Compose overrides SMTP_HOST=mailpit; use localhost when running backend on host)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@registration-core.local
SMTP_FROM_NAME=CTVET
EMAIL_CONSOLE_FALLBACK=true
PASSWORD_SETUP_TOKEN_EXPIRY_HOURS=48
PASSWORD_SETUP_RATE_LIMIT_PER_MINUTE=10

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:3002,http://127.0.0.1:3002

# Storage Configuration
STORAGE_BACKEND=local
STORAGE_PATH=storage/documents
PHOTO_STORAGE_PATH=storage/photos
EXPORT_STORAGE_PATH=storage/exports

# File Upload Limits
STORAGE_MAX_SIZE=52428800
PHOTO_MAX_FILE_SIZE=2097152
UPLOAD_MAX_SIZE=10485760

# Payment Configuration (Paystack) — required for private registration payments
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_CALLBACK_BASE_URL=http://localhost:3002

# Result access PIN settings
RESULT_ACCESS_PIN_DEFAULT_MAX_USES=5
RESULT_ACCESS_PIN_LENGTH=6
RESULT_ACCESS_SERIAL_LENGTH=8

# School completion declaration QR signing (optional; falls back to SECRET_KEY)
# COMPLETION_DECLARATION_SECRET=

# SMS (Nalo) — principal notification after school registration confirmation
SMS_ENABLED=false
NALO_SMS_KEY=
NALO_SMS_SENDER_ID=CTVET
NALO_SMS_URL=https://sms.nalosolutions.com/smsbackend/Resl_Nalo/send-message/
