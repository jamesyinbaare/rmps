# Deployment Environment Variables
# Copy this file to .env.deploy and update with your actual values

# Database Configuration
POSTGRES_USER=registration_user
POSTGRES_PASSWORD=your_secure_password_here
REGISTRATION_POSTGRES_DB=registration_core_db
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@registration_core_postgres:5432/${REGISTRATION_POSTGRES_DB}

# Application Environment
ENVIRONMENT=production
APP_ENV=prod
APP_LOG_LEVEL=INFO
APP_LOG_FORMAT=json

# Security - IMPORTANT: Change these in production!
SECRET_KEY=your-very-secure-secret-key-change-this-in-production
ALGORITHM=HS256

# Authentication Settings
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=8

# System Admin Initialization (Required)
SYSTEM_ADMIN_EMAIL=admin@example.com
SYSTEM_ADMIN_PASSWORD=changeme
SYSTEM_ADMIN_FULL_NAME="System Administrator"

# Frontend Configuration
NEXT_PUBLIC_API_BASE_URL=https://api.backend.localhost
FRONTEND_BASE_URL=https://frontend.localhost

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=https://frontend.localhost,http://localhost:3002,http://127.0.0.1:3002

# Storage Configuration
STORAGE_BACKEND=local
STORAGE_PATH=storage/documents
PHOTO_STORAGE_PATH=storage/photos
EXPORT_STORAGE_PATH=storage/exports

# File Upload Limits
STORAGE_MAX_SIZE=52428800
PHOTO_MAX_FILE_SIZE=2097152
UPLOAD_MAX_SIZE=10485760

# Payment Configuration (Paystack)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_CALLBACK_BASE_URL=https://frontend.localhost

# Result access PIN settings
RESULT_ACCESS_PIN_DEFAULT_MAX_USES=5
RESULT_ACCESS_PIN_LENGTH=6
RESULT_ACCESS_SERIAL_LENGTH=8
